source_set("fingerprint_browser") {
  sources = [
    "diagnostics/diagnostics_data_collector.cc",
    "diagnostics/diagnostics_data_collector.h",
    "diagnostics/diagnostics_event_journal.cc",
    "diagnostics/diagnostics_event_journal.h",
    "diagnostics/diagnostics_exporter.cc",
    "diagnostics/diagnostics_exporter.h",
    "fingerprint_proxy_service.cc",
    "fingerprint_proxy_service.h",
    "fingerprint_proxy_service_factory.cc",
    "fingerprint_proxy_service_factory.h",
    "persona_service_factory.cc",
    "persona_service_factory.h",
  ]

  public_deps = [
    "//brave/components/fingerprint_browser/browser",
    "//services/network/public/cpp",
  ]

  deps = [
    "//base",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/os_crypt/async/browser",
    "//components/os_crypt/async/common",
    "//components/pref_registry",
    "//components/prefs",
    "//components/proxy_config",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/common",
    "//components/crash/core/app",
    "//components/feedback/redaction_tool",
    "//crypto",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/cert_verifier/public/mojom",
    "//services/network/public/mojom",
    "//third_party/crashpad/crashpad/client",
    "//third_party/zlib/google:zip",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "diagnostics/diagnostics_event_journal_unittest.cc",
    "diagnostics/diagnostics_exporter_unittest.cc",
  ]

  deps = [
    ":fingerprint_browser",
    "//base/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//third_party/zlib/google:zip",
  ]
}
