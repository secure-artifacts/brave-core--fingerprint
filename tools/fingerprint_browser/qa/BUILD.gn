import("//testing/test.gni")

test("fingerprint_browser_worker_watcher_unittests") {
  sources = [ "//components/performance_manager/worker_watcher_unittest.cc" ]

  deps = [
    "//components/performance_manager",
    "//components/performance_manager/test_support",
    "//components/test:run_all_unittests",
    "//content/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

# Keep the Facebook crash regression focused on Blink inline layout. The
# monolithic blink_unittests target also compiles unrelated Brave override
# tests, so this target gives release validation a small, deterministic gate.
test("fingerprint_browser_inline_layout_unittests") {
  deps = [ "//third_party/blink/renderer/controller:fingerprint_browser_inline_layout_test_sources" ]
}
