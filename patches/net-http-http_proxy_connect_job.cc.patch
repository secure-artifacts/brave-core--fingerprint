+bool HttpProxyConnectJob::RestartWithConfiguredProxyAuthCredentials() {
+  const HostPortPair& proxy_host_port =
+      params_->proxy_server().host_port_pair();
+  if (proxy_host_port.username().empty() &&
+      proxy_host_port.password().empty()) {
+    return false;
+  }
+
+  if (configured_proxy_auth_credentials_attempted_) {
+    NotifyDelegateOfCompletion(ERR_INVALID_AUTH_CREDENTIALS);
+    return true;
+  }
+
+  HttpAuthController* auth_controller =
+      transport_socket_->GetAuthController().get();
+  if (!auth_controller || !auth_controller->HaveAuthHandler()) {
+    return false;
+  }
+
+  configured_proxy_auth_credentials_attempted_ = true;
+  if (!auth_controller->HaveAuth()) {
+    auth_controller->ResetAuth(
+        AuthCredentials(base::UTF8ToUTF16(proxy_host_port.username()),
+                        base::UTF8ToUTF16(proxy_host_port.password())));
+  }
+  RestartWithAuthCredentials();
+  return true;
+}
