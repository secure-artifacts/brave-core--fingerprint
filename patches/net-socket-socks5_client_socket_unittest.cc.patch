+std::unique_ptr<SOCKS5ClientSocket> SOCKS5ClientSocketTest::BuildMockAuthSocket(
+    base::span<const MockRead> reads,
+    base::span<const MockWrite> writes,
+    std::string_view hostname,
+    int port,
+    std::string_view username,
+    std::string_view password,
+    NetLog* net_log) {
+  TestCompletionCallback callback;
+  data_ = std::make_unique<StaticSocketDataProvider>(reads, writes);
+  auto tcp_sock = std::make_unique<MockTCPClientSocket>(address_list_, net_log,
+                                                        data_.get());
+  tcp_sock_ = tcp_sock.get();
+
+  int rv = tcp_sock_->Connect(callback.callback());
+  EXPECT_THAT(rv, IsError(ERR_IO_PENDING));
+  rv = callback.WaitForResult();
+  EXPECT_THAT(rv, IsOk());
+  EXPECT_TRUE(tcp_sock_->IsConnected());
+
+  const TransportSocketParams::Endpoint proxy_endpoint =
+      HostPortPair(username, password, "127.0.0.1", 1080);
+  return std::make_unique<SOCKS5ClientSocketAuth>(
+      std::move(tcp_sock), HostPortPair(hostname, port),
+      TRAFFIC_ANNOTATION_FOR_TESTS, proxy_endpoint);
+}
