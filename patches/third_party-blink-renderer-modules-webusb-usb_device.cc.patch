+String USBDevice::serialNumber() const {
+  if (Info().serial_number.IsNull() || Info().serial_number.empty()) {
+    return Info().serial_number;
+  }
+
+  ExecutionContext* context = GetExecutionContext();
+  if (!context ||
+      brave::GetBraveFarblingLevelFor(
+          context,
+          ContentSettingsType::BRAVE_WEBCOMPAT_USB_DEVICE_SERIAL_NUMBER,
+          BraveFarblingLevel::OFF) == BraveFarblingLevel::OFF) {
+    return Info().serial_number;
+  }
+
+  return brave::BraveSessionCache::From(*context).GenerateRandomString(
+      Info().serial_number.Utf8(), Info().serial_number.length());
+}
