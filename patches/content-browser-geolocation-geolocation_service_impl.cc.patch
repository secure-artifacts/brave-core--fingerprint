   void QueryCachedPosition(QueryCachedPositionCallback callback) override {
+    if (ReplyWithProfileGeolocationOverride(std::move(callback))) {
+      return;
+    }
     geolocation_impl_remote_->QueryCachedPosition(std::move(callback));
   }
   void QueryNextPosition(QueryNextPositionCallback callback) override {
+    if (ReplyWithProfileGeolocationOverride(std::move(callback))) {
+      return;
+    }
     geolocation_impl_remote_->QueryNextPosition(std::move(callback));
   }

  private:
+  template <typename Callback>
+  bool ReplyWithProfileGeolocationOverride(Callback callback) {
+    double latitude = 0.0;
+    double longitude = 0.0;
+    double accuracy = 0.0;
+    if (!GetContentClient()->browser()->GetProfileGeolocationOverride(
+            service_impl_->render_frame_host_, &latitude, &longitude,
+            &accuracy)) {
+      return false;
+    }
+
+    auto position = device::mojom::Geoposition::New();
+    position->latitude = latitude;
+    position->longitude = longitude;
+    position->accuracy = accuracy;
+    position->timestamp = base::Time::Now();
+    position->is_precise = false;
+    std::move(callback).Run(
+        device::mojom::GeopositionResult::NewPosition(std::move(position)));
+    return true;
+  }
+
   void OnDisconnect() { service_impl_->OnProxyDisconnected(this); }

