+void ProxyConfigMonitor::UpdateFingerprintBrowserProfileProxyConfig() {
+  DCHECK(fingerprint_browser_profile_);
+
+  const auto proxy_server =
+      fingerprint_browser::GetProfileProxyServerFromPrefs(
+          *fingerprint_browser_profile_->GetPrefs());
+  const bool should_use_profile_proxy =
+      fingerprint_browser::ShouldUseProfileProxy(
+          *fingerprint_browser_profile_->GetPrefs());
+
+  if (should_use_profile_proxy) {
+    DCHECK(proxy_server);
+    if (uses_fingerprint_browser_profile_proxy_) {
+      static_cast<net::ProfileProxyConfigService*>(proxy_config_service_.get())
+          ->UpdateProxyServer(*proxy_server);
+      return;
+    }
+    ReplaceProxyConfigService(
+        CreateFingerprintBrowserProfileProxyConfigService(
+            fingerprint_browser_profile_),
+        true);
+    return;
+  }
+
+  if (!uses_fingerprint_browser_profile_proxy_ && proxy_config_service_) {
+    return;
+  }
+  ReplaceProxyConfigService(
+      ProxyServiceFactory::CreateProxyConfigService(
+          pref_proxy_config_tracker_.get(), fingerprint_browser_profile_),
+      false);
+}
+
+void ProxyConfigMonitor::ReplaceProxyConfigService(
+    std::unique_ptr<net::ProxyConfigService> proxy_config_service,
+    bool uses_fingerprint_browser_profile_proxy) {
+  if (proxy_config_service_) {
+    proxy_config_service_->RemoveObserver(this);
+  }
+  proxy_config_service_ = std::move(proxy_config_service);
+  uses_fingerprint_browser_profile_proxy_ =
+      uses_fingerprint_browser_profile_proxy;
+  proxy_config_service_->AddObserver(this);
+
+  net::ProxyConfigWithAnnotation config;
+  const auto availability = proxy_config_service_->GetLatestProxyConfig(&config);
+  if (availability != net::ProxyConfigService::CONFIG_PENDING) {
+    OnProxyConfigChanged(config, availability);
+  }
+}
