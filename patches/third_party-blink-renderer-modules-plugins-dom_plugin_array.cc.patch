+
+String PluginReplacementName(brave_shields::FarblingPRNG* prng) {
+  std::vector<String> chrome{"Chrome ", "Chromium ",   "Brave ",
+                             "Web ",    "Browser ",    "OpenSource ",
+                             "Online ", "JavaScript ", ""};
+  std::vector<String> pdf{"PDF ",
+                          "Portable Document Format ",
+                          "portable-document-format ",
+                          "document ",
+                          "doc ",
+                          "PDF and PS ",
+                          "com.adobe.pdf "};
+  std::vector<String> viewer{"Viewer",  "Renderer", "Display",   "Plugin",
+                             "plug-in", "plug in",  "extension", ""};
+  return StrCat({chrome[(*prng)() % chrome.size()], pdf[(*prng)() % pdf.size()],
+                 viewer[(*prng)() % viewer.size()]});
+}
+
+MimeClassInfo* AddMimeTypeToPluginInfo(PluginInfo* plugin_info,
+                                       const String& mime_type,
+                                       const String& description,
+                                       const String& extension) {
+  Vector<String> extensions{extension};
+  auto* mime_info = MakeGarbageCollected<MimeClassInfo>(
+      mime_type, description, *plugin_info, extensions);
+  plugin_info->AddMimeType(mime_info);
+  return mime_info;
+}
+
+DOMPlugin* MakeBraveFakePlugin(LocalDOMWindow* window,
+                               const String& name,
+                               const String& filename,
+                               const String& description,
+                               const std::vector<const char*>& mime_types,
+                               const String& mime_description,
+                               const String& plugin_extension) {
+  auto* plugin_info = MakeGarbageCollected<PluginInfo>(
+      name, filename, description, Color::kTransparent,
+      /*may_use_external_handler=*/false);
+  for (const char* mime_type : mime_types) {
+    AddMimeTypeToPluginInfo(plugin_info, mime_type, mime_description,
+                            plugin_extension);
+  }
+  return MakeGarbageCollected<DOMPlugin>(window, *plugin_info);
+}
+
+DOMPlugin* MakePersonaPlugin(LocalDOMWindow* window,
+                             const brave::PersonaPluginValue& plugin) {
+  auto* plugin_info = MakeGarbageCollected<PluginInfo>(
+      plugin.name, plugin.filename, plugin.description, Color::kTransparent,
+      /*may_use_external_handler=*/false);
+  for (const auto& mime_type : plugin.mime_types) {
+    auto* mime_info = MakeGarbageCollected<MimeClassInfo>(
+        mime_type.type, mime_type.description, *plugin_info,
+        mime_type.suffixes);
+    plugin_info->AddMimeType(mime_info);
+  }
+  return MakeGarbageCollected<DOMPlugin>(window, *plugin_info);
+}
+
+void ApplyBravePluginPolicy(LocalDOMWindow* window,
+                            HeapVector<Member<DOMPlugin>>& dom_plugins) {
+  auto farbling_level = brave::GetBraveFarblingLevelFor(
+      window, ContentSettingsType::BRAVE_WEBCOMPAT_PLUGINS,
+      BraveFarblingLevel::OFF);
+  if (farbling_level == BraveFarblingLevel::OFF || !window) {
+    return;
+  }
+
+  brave::BraveSessionCache& cache = brave::BraveSessionCache::From(*window);
+  if (auto persona_plugins = cache.PersonaPlugins()) {
+    dom_plugins.clear();
+    for (const auto& plugin : *persona_plugins) {
+      dom_plugins.push_back(MakePersonaPlugin(window, plugin));
+    }
+    return;
+  }
+
+  switch (farbling_level) {
+    case BraveFarblingLevel::MAXIMUM:
+      dom_plugins.clear();
+      [[fallthrough]];
+    case BraveFarblingLevel::BALANCED: {
+      brave_shields::FarblingPRNG prng = cache.MakePseudoRandomGenerator();
+      for (unsigned index = 0; index < dom_plugins.size(); index++) {
+        auto plugin = dom_plugins[index];
+        String name = plugin->name();
+        String description = plugin->description();
+        if ((name == "Chrome PDF Plugin") || (name == "Chrome PDF Viewer")) {
+          std::vector<const char*> mime_types{"application/pdf", "text/pdf"};
+          dom_plugins[index] = MakeBraveFakePlugin(
+              window, PluginReplacementName(&prng),
+              cache.GenerateRandomString(plugin->filename().Ascii(), 32),
+              description, mime_types, description, "pdf");
+        }
+      }
+
+      dom_plugins.push_back(MakeBraveFakePlugin(
+          window, cache.GenerateRandomString("PLUGIN_1_NAME", 8),
+          cache.GenerateRandomString("PLUGIN_1_FILENAME", 16),
+          cache.GenerateRandomString("PLUGIN_1_DESCRIPTION", 32),
+          std::vector<const char*>{"", ""},
+          cache.GenerateRandomString("MIME_1_DESCRIPTION", 32),
+          cache.GenerateRandomString("PLUGIN_1_EXTENSION", 3)));
+      dom_plugins.push_back(MakeBraveFakePlugin(
+          window, cache.GenerateRandomString("PLUGIN_2_NAME", 7),
+          cache.GenerateRandomString("PLUGIN_2_FILENAME", 15),
+          cache.GenerateRandomString("PLUGIN_2_DESCRIPTION", 31),
+          std::vector<const char*>{"", ""},
+          cache.GenerateRandomString("MIME_2_DESCRIPTION", 32),
+          cache.GenerateRandomString("PLUGIN_2_EXTENSION", 3)));
+      std::shuffle(dom_plugins.begin(), dom_plugins.end(), prng);
+      return;
+    }
+    case BraveFarblingLevel::OFF:
+      return;
+  }
+}
