+std::optional<int>
+HttpNetworkTransaction::RestartWithConfiguredProxyAuthCredentials() {
+  if (pending_auth_target_ != HttpAuth::AUTH_PROXY ||
+      !UsingHttpProxyWithoutTunnel()) {
+    return std::nullopt;
+  }
+
+  CHECK(proxy_info_.proxy_chain().is_single_proxy());
+  const HostPortPair& proxy_host_port =
+      proxy_info_.proxy_chain().First().host_port_pair();
+  if (proxy_host_port.username().empty() &&
+      proxy_host_port.password().empty()) {
+    return std::nullopt;
+  }
+
+  if (configured_proxy_auth_credentials_attempted_) {
+    pending_auth_target_ = HttpAuth::AUTH_NONE;
+    return ERR_INVALID_AUTH_CREDENTIALS;
+  }
+
+  HttpAuthController* auth_controller =
+      auth_controllers_[HttpAuth::AUTH_PROXY].get();
+  if (!auth_controller || !auth_controller->HaveAuthHandler()) {
+    return std::nullopt;
+  }
+
+  configured_proxy_auth_credentials_attempted_ = true;
+  pending_auth_target_ = HttpAuth::AUTH_NONE;
+  if (!auth_controller->HaveAuth()) {
+    auth_controller->ResetAuth(
+        AuthCredentials(base::UTF8ToUTF16(proxy_host_port.username()),
+                        base::UTF8ToUTF16(proxy_host_port.password())));
+  }
+  PrepareForAuthRestart(HttpAuth::AUTH_PROXY);
+  return OK;
+}
