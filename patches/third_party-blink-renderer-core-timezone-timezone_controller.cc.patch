+void TimeZoneController::SetFingerprintBrowserTimezoneOverride(
+    const String& timezone_id) {
+  base::AutoLock locker(instance().lock_);
+
+  const String previous_baseline = instance().BaselineTimeZoneId();
+  if (timezone_id.empty()) {
+    instance().fingerprint_browser_timezone_id_ = String();
+    if (!HasTimeZoneOverride() &&
+        !CanonicalEquals(previous_baseline, instance().GetHostTimezoneId())) {
+      SetIcuTimeZoneAndNotifyV8(instance().GetHostTimezoneId());
+    }
+    return;
+  }
+
+  if (CanonicalEquals(instance().fingerprint_browser_timezone_id_,
+                      timezone_id)) {
+    return;
+  }
+
+  if (!IsValidTimezoneId(timezone_id)) {
+    VLOG(1) << "Invalid fingerprint browser timezone id: " << timezone_id;
+    return;
+  }
+  if (!HasTimeZoneOverride() &&
+      !CanonicalEquals(previous_baseline, timezone_id)) {
+    SetIcuTimeZoneAndNotifyV8(timezone_id);
+  }
+  instance().fingerprint_browser_timezone_id_ = timezone_id;
+}
