+TEST_F(MediaRouterEnabledTest, TestDisabledByProfileProxyIdentity) {
+  EnableFingerprintProfileProxy(&enabled_profile);
+
+  EXPECT_FALSE(MediaRouterEnabled(&enabled_profile));
+
+  TestingProfile* incognito_profile =
+      TestingProfile::Builder().BuildIncognito(&enabled_profile);
+  EXPECT_FALSE(MediaRouterEnabled(incognito_profile));
+}
