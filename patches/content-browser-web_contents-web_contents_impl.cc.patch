+  DCHECK(browser_context);
+  for (WebContentsImpl* web_contents : WebContentsImpl::GetAllWebContents()) {
+    if (web_contents->GetBrowserContext() == browser_context) {
+      web_contents->SyncRendererPrefs();
+    }
